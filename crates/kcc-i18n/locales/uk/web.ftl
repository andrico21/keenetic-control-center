web-routing-protocol-esp = ESP
web-routing-protocol-gre = GRE
web-routing-protocol-ipip = IP в IP
web-routing-protocol-ip = Будь-який протокол IP
web-routing-policy-add = Додати політику
web-routing-col-interfaces = Інтерфейси за порядком
web-routing-col-multipath = Багатошляхова маршрутизація
