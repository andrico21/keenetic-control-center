# Command-line output.

cli-router-added = Router { $name } added.
cli-router-removed = Router { $name } removed.
cli-no-routers = No routers are configured.
cli-connected = Connected to { $model } running firmware { $version }.
cli-config-written = Configuration written to { $path }.
cli-router-updated = Router { $name } updated.
cli-router-required = Choose a router with --router; several or no routers are configured.
cli-error-generic = The command failed.
cli-error-usage = The command line is incomplete or invalid.
cli-error-auth = Authentication failed. Check the login and the password file.
cli-error-validation = The request was rejected before anything was sent.
cli-error-conflict = The action conflicts with the current state (router busy, changed by someone else, or already existing); nothing was changed.
cli-error-router = The router could not be reached or reported an error.
cli-error-partial = Some items of the batch failed.
cli-error-policy = Refused by policy.
cli-profile-login-protected = Change this password on the router, then update the profile with `kcc router edit --new-password`.
cli-refused = The CLI role or router scope does not allow this on { $router }.
cli-apply-recovery-forbidden = Applying cannot contact the router. Missing permissions: { $missing }.
cli-secret-missing = No secret given: use --password-file, the KCC_PASSWORD variable, or run on a terminal.
cli-confirm-ask = Apply this change to { $router }? Type yes to continue:
cli-confirm-type = This is destructive. Type the router id { $router } to continue:
cli-confirm-missing = Not confirmed for { $router }: use --yes, or --confirm-destructive with the router id for destructive changes.
cli-col-id = ID
cli-col-url = URL
cli-col-login = Login
cli-col-source = Source
cli-col-tags = Tags
cli-col-name = Name
cli-col-reason = Reason
cli-col-created = Created
cli-col-user = User
cli-col-role = Role
cli-col-disabled = Disabled
cli-col-mac = MAC address
cli-col-address = IP address
cli-col-interface = Interface
cli-col-access = Access
cli-tier-hardware = verified on hardware
cli-tier-documentation = documentation-based (not verified on hardware)
cli-tier-unsupported = unsupported
cli-info-model = Model: { $model } ({ $name })
cli-info-firmware = Firmware: { $version }
cli-info-tier = Support tier: { $value }
cli-prompt-router-password = Password for router { $router }:
cli-prompt-new-password = New password for { $user }:
cli-prompt-current-password = Current password of { $user }:
cli-applied = Change applied. It is not saved yet: run kcc config save to keep it after a reboot.
cli-saved = Configuration saved.
cli-config-unsaved = Unsaved changes: { $value }
cli-config-agent = Last changed by: { $value }
cli-config-failsafe = Fail-safe timer armed: { $value }
cli-deleted = { $name } deleted.
cli-yes = yes
cli-no = no
cli-user-added = Account { $user } added.
cli-password-rejected = The current password is wrong, or the account is locked or disabled.
cli-password-changed = Password of { $user } changed.
cli-not-found = { $name } was not found.
cli-key-once = API key { $name } created. It is shown only now:
cli-admin-exists = An administrator account already exists.
cli-admin-created = Administrator { $user } created. Its password is shown only now; change it at the first login:
cli-audit-valid = The audit log is intact: { $count } entries.
cli-audit-broken = The audit hash chain is broken at sequence { $value }.
cli-tls-written = Certificate written to { $path }. SHA-256: { $value }
cli-plan-written = Plan written to { $path }: { $count } lines to apply.
cli-plan-changed = The plan no longer matches the routers; plan again and review the new plan.
cli-plan-blocked = The plan needs more input: { $value }
cli-plan-conflict = resolve conflict in { $item }
cli-migrate-kept = The fail-safe timer keeps running: finish with kcc migrate finish commit or rollback.
cli-col-groups = Groups
cli-col-firmware = Firmware
cli-preset-captured = Preset { $name } captured: { $count } lines.
cli-preset-deleted = Preset { $name } deleted.
cli-preset-plan = Preset { $name } onto { $router } ({ $value }): { $count } items.
cli-preset-blocked = The plan needs more input: { $value }. Leave those items out with --exclude.
cli-preset-target-older = { $router } runs firmware { $value }, older than the preset's { $version }; nothing was sent.
cli-preset-finish-required = Choose how the run ends with --finish keep-unsaved, save or rollback; nothing was changed.
cli-preset-finish-ask = The settings are applied and verified on { $router }. Type keep-unsaved, save or rollback:
cli-preset-finish-left = No choice was made: the fail-safe timer stays armed and restores the saved configuration; finish with kcc preset finish { $value } keep-unsaved, save or rollback.
cli-preset-finished = Run { $name } on { $router } finished: { $value }.
cli-preset-not-run = { $name } is not a preset or migration run.
cli-preset-run = Run { $name } started on { $router }.

cli-job-completed = Job { $name } completed.
cli-job-failed = Job { $name } did not complete.
cli-name-taken = { $name } already exists; choose another name.
cli-persists-immediately = Takes effect and is saved by the router at once: no save is needed and the fail-safe timer cannot roll it back.
cli-mixed-persistence = The router saved these catalog paths at once: { $paths }. The rest is not saved and needs an explicit save.
cli-applied-persisted = Change applied. The router stored it already; no save is needed.
cli-mixed-persistence-before = The router will save these catalog paths at once: { $paths }. The rest will stay unsaved until you save it.
cli-error-not-applied = The router did not apply the change: reading it back still shows the old value.
cli-batch-refused = Some items were refused by the router. Succeeded: { $succeeded }; refused: { $failed }.
cli-account-disabled = Sign-in disabled for { $user }.
cli-account-enabled = Sign-in enabled for { $user }.
cli-failsafe-running = The fail-safe timer is running: when it runs out, the router restores its saved configuration and restarts. Keep the changes before then with kcc config failsafe commit.
cli-failsafe-committed = Changes kept: the router saved its configuration.
cli-failsafe-rolled-back = Changes rolled back: the router restored its saved configuration and may restart.
cli-migrate-committed = The migration is committed: the router saved the migrated configuration.
cli-migrate-rolled-back = The migration is rolled back: the router runs the configuration it had saved before.
cli-done-terminal = The router is carrying it out. It may not answer for a few minutes.
cli-error-firewall-verification = The router did not show the expected configuration after the change; check it before retrying.
failsafe-rollback-rebooting = The router is restarting with its saved configuration.
cli-done = Done.
cli-router-out-of-scope = Your role does not cover router { $router }.
cli-prompt-router-token = Login token for router { $router }:
cli-prompt-router-read-password = Read-only password for router { $router }:
cli-router-token-needs-token-auth = --token-file and --new-token need --auth token.
cli-router-read-needs-login = --read-password-file and --new-read-password need a read-only login (--read-login).
cli-router-password-needs-password-auth = Router { $router } signs in with a token: use --new-token, or switch with --auth <mode> --new-password.
cli-router-switch-needs-token = Switching router { $router } to token sign-in needs a new token (--new-token or --token-file).
cli-router-switch-needs-password = Switching router { $router } to password sign-in needs a new password (--new-password).
cli-router-credential-required = Changing the URL, login or TLS pin of router { $router } needs its password or token again (--new-password or --new-token).
cli-router-external-password = Router { $router } reads its password from the plaintext file { $path }. Seal it with: kcc router edit { $router } --new-password --password-file { $path }
cli-listener-in-use = kcc reaches this router through that listener, so the change would cut kcc off and roll back every unsaved change; it was not sent. Change it on the router, then edit the router URL in kcc with `kcc router edit --url`.
cli-router-password-env-shared = KCC_PASSWORD can stand in for one secret per command only. Give the other secrets with --password-file, --token-file or --read-password-file.
cli-dhcp-pool-replace-needs = DHCP pool { $name } already exists. To replace it, also give { $missing }, or its current settings would be reset to the defaults; nothing was sent.
cli-backup-diff-too-large = The two backups differ in too many commands to compare in order. Nothing was printed; compare them in the Web UI or compare the files on disk.
cli-failsafe-seconds-range = --seconds must be 300..=3600
cli-startup-config-not-utf8 = startup configuration is not UTF-8
cli-user-password-format = --user-password takes <user>=<file>
cli-from-format = --from must be <router-id>, router:<id>, backup:<router>/<name> or file:<path>
cli-source-no-firmware = the source names no firmware version
cli-route-ipv4-options = --mask and --metric are IPv4 options
cli-wireguard-conf-too-large = the WireGuard configuration is larger than 64 KiB
cli-role-unknown = [cli] role { $name } does not exist
cli-tls-no-out-dir = no --out-dir and no platform config directory
cli-health-cert-empty = the server certificate file is empty
cli-health-status = /healthz answered { $status }
cli-migration-job-no-result = the migration job ended without a result
cli-preset-job-no-result = the preset job ended without a result
cli-lang-unsupported = unsupported --lang { $value }; use en, ru, uk, de, be or kk
cli-serve-no-config-path = no config path and no platform config directory
cli-serve-locked = cannot start kcc serve with state directory { $path }: another kcc serve holds the server lock ({ $reason })
cli-serve-log-metrics-unavailable = log metrics are unavailable
cli-serve-stdio-role-unknown = configured stdio role { $name } does not exist
cli-serve-locale-unsupported = web.default_locale is unsupported
cli-serve-bind = bind { $address }:{ $port }: { $reason }
cli-serve-audit-writer-terminated = audit writer terminated

# kcc notify
cli-notify-on = on
cli-notify-off = off
cli-notify-enabled = Notifications: { $value }
cli-notify-locale = Message language: { $value }
cli-notify-locale-default = server default
cli-notify-client-details = Client names and MAC addresses in messages: { $value }
cli-notify-events = Events: { $value }
cli-notify-events-none = none
cli-notify-token-set = Bot token: set on { $time }
cli-notify-token-none = Bot token: not set
cli-notify-token-rejected = Telegram refused the bot token on { $time }. No messages are sent until a new token is set with kcc notify token.
cli-notify-chats = Chats:
cli-notify-chats-none = Chats: none. Messages need at least one; add one with kcc notify chat add.
cli-notify-chat-thread = topic { $value }
cli-notify-chat-silent = without sound
cli-notify-chat-forbidden = disabled since { $time }: the bot was blocked or removed from the chat
cli-notify-chat-not-found = disabled since { $time }: Telegram does not know this chat
cli-notify-settings-saved = Notification settings saved.
cli-notify-token-prompt = Bot token:
cli-notify-token-saved = Bot token saved.
cli-notify-token-cleared = Bot token removed.
cli-notify-token-invalid = This is not a bot token: it is digits, a colon, then 30 to 64 letters, digits, - or _.
cli-notify-event-unknown = Unknown event { $value }. Give a comma-separated list of { $known }, or default.
cli-notify-locale-unknown = Unknown language { $value }. Use en, ru, uk, de, be, kk or default.
cli-notify-chat-id-invalid = This is not a chat ID: use a non-zero number such as -1001234567890 or a public @username of 5 to 32 letters, digits or _.
cli-notify-chat-label-invalid = The label must be 1 to 64 characters without control characters.
cli-notify-chat-exists = Chat { $id } is already listed.
cli-notify-chats-full = At most { $max } chats can be listed.
cli-notify-chat-unknown = Chat { $id } is not listed.
cli-notify-chat-added = Chat added.
cli-notify-chat-removed = Chat removed.
cli-notify-no-chats = No chat is listed; add one with kcc notify chat add.
cli-notify-test-text = Test message from Keenetic Control Center: notifications reach this chat.
cli-notify-test-sent = Test message sent to { $name }.
cli-notify-test-failed = Reason: { $reason } ({ $class }).
cli-notify-test-not-sent = The test message was not sent.
cli-notify-failure-no-token = No bot token is set
cli-notify-failure-token-rejected = Telegram refused the bot token
cli-notify-failure-chat-refused = Telegram refused this chat
cli-notify-failure-rate-limited = Telegram asked to wait before the next message
cli-notify-failure-unreachable = Telegram could not be reached
cli-notify-failure-rejected = Telegram refused the message
