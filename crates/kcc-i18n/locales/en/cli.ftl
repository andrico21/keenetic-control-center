# Command-line output.

cli-about = Manage Keenetic and Netcraze routers from the command line, the Web UI and MCP.
cli-router-added = Router { $name } added.
cli-router-removed = Router { $name } removed.
cli-no-routers = No routers are configured.
cli-connecting = Connecting to { $url }...
cli-connected = Connected to { $model } running firmware { $version }.
cli-config-written = Configuration written to { $path }.
cli-dry-run = Dry run: no changes were sent to the router.
cli-changes-applied =
    { $count ->
        [one] { $count } change applied.
       *[other] { $count } changes applied.
    }
cli-router-updated = Router { $name } updated.
cli-router-required = Choose a router with --router; several or no routers are configured.
cli-error-generic = The command failed.
cli-error-usage = The command line is incomplete or invalid.
cli-error-auth = Authentication failed. Check the login and the password file.
cli-error-validation = The request was rejected before anything was sent.
cli-error-conflict = The action conflicts with the current state (router busy, changed by someone else, or already existing); nothing was changed.
cli-error-router = The router could not be reached or reported an error.
cli-error-partial = Some items of the batch failed.
cli-error-policy = Refused by policy.
cli-profile-login-protected = Change this password on the router, then update the profile with `kcc router edit --new-password`.
cli-refused = The CLI role or router scope does not allow this on { $router }.
cli-secret-missing = No secret given: use --password-file, the KCC_PASSWORD variable, or run on a terminal.
cli-confirm-ask = Apply this change to { $router }? Type yes to continue:
cli-confirm-type = This is destructive. Type the router id { $router } to continue:
cli-confirm-missing = Not confirmed for { $router }: use --yes, or --confirm-destructive with the router id for destructive changes.
cli-failsafe-left = The router stopped answering; its fail-safe timer stays armed and will restore the saved configuration.
cli-col-id = ID
cli-col-url = URL
cli-col-login = Login
cli-col-source = Source
cli-col-tags = Tags
cli-col-name = Name
cli-col-reason = Reason
cli-col-created = Created
cli-col-user = User
cli-col-role = Role
cli-col-disabled = Disabled
cli-col-mac = MAC address
cli-col-address = IP address
cli-col-interface = Interface
cli-col-access = Access
cli-tier-hardware = verified on hardware
cli-tier-documentation = documentation-based (not verified on hardware)
cli-tier-unsupported = unsupported
cli-info-model = Model: { $model } ({ $name })
cli-info-firmware = Firmware: { $version }
cli-info-tier = Support tier: { $value }
cli-prompt-router-password = Password for router { $router }:
cli-prompt-new-password = New password for { $user }:
cli-prompt-current-password = Current password of { $user }:
cli-applied = Change applied. It is not saved yet: run kcc config save to keep it after a reboot.
cli-saved = Configuration saved.
cli-config-unsaved = Unsaved changes: { $value }
cli-config-agent = Last changed by: { $value }
cli-config-failsafe = Fail-safe timer armed: { $value }
cli-deleted = { $name } deleted.
cli-yes = yes
cli-no = no
cli-user-added = Account { $user } added.
cli-password-rejected = The current password is wrong, or the account is locked or disabled.
cli-password-changed = Password of { $user } changed.
cli-not-found = { $name } was not found.
cli-key-once = API key { $name } created. It is shown only now:
cli-admin-exists = An administrator account already exists.
cli-admin-created = Administrator { $user } created. Its password is shown only now; change it at the first login:
cli-audit-valid = The audit log is intact: { $count } entries.
cli-audit-broken = The audit hash chain is broken at sequence { $value }.
cli-tls-written = Certificate written to { $path }. SHA-256: { $value }
cli-plan-written = Plan written to { $path }: { $count } lines to apply.
cli-plan-changed = The plan no longer matches the routers; plan again and review the new plan.
cli-plan-blocked = The plan needs more input: { $value }
cli-plan-conflict = resolve conflict in { $item }
cli-migrate-kept = The fail-safe timer keeps running: finish with kcc migrate finish commit or rollback.
cli-col-groups = Groups
cli-col-firmware = Firmware
cli-preset-captured = Preset { $name } captured: { $count } lines.
cli-preset-deleted = Preset { $name } deleted.
cli-preset-plan = Preset { $name } onto { $router } ({ $value }): { $count } items.
cli-preset-blocked = The plan needs more input: { $value }. Leave those items out with --exclude.
cli-preset-target-older = { $router } runs firmware { $value }, older than the preset's { $version }; nothing was sent.
cli-preset-finish-required = Choose how the run ends with --finish keep-unsaved, save or rollback; nothing was changed.
cli-preset-finish-ask = The settings are applied and verified on { $router }. Type keep-unsaved, save or rollback:
cli-preset-finish-left = No choice was made: the fail-safe timer stays armed and restores the saved configuration; finish with kcc preset finish { $value } keep-unsaved, save or rollback.
cli-preset-finished = Run { $name } on { $router } finished: { $value }.
cli-preset-not-run = { $name } is not a preset or migration run.
cli-preset-run = Run { $name } started on { $router }.

cli-job-completed = Job { $name } completed.
cli-job-failed = Job { $name } did not complete.
cli-name-taken = { $name } already exists; choose another name.
cli-persists-immediately = Takes effect and is saved by the router at once: no save is needed and the fail-safe timer cannot roll it back.
cli-mixed-persistence = The router saved these catalog paths at once: { $paths }. The rest is not saved and needs an explicit save.
cli-applied-persisted = Change applied. The router stored it already; no save is needed.
cli-error-not-applied = The router did not apply the change: reading it back still shows the old value.
