cli-entware-ssh-confirmation-invalid = Билет `kcc entware ssh probe` шығарған 64 он алтылық цифрдан, ал саусақ ізі SHA256: және 43 base64 таңбасынан тұруы керек. Ештеңе жіберілмеді.
cli-entware-ssh-chroot = { $router } роутерінде opkg chroot қосулы, сондықтан kcc Entware-ді SSH арқылы басқара алмайды: оны `kcc entware set chroot off` командасымен өшіріңіз.
cli-entware-ssh-host-changed = { $router } роутерінің URL хосты тіркелгеннен кейін өзгерді, кілт байламы тасталды: probe және bootstrap қайта орындаңыз.
cli-entware-ssh-not-enrolled = { $router } роутері үшін Entware SSH тіркелмеген: `kcc entware ssh probe`, содан кейін `kcc entware ssh bootstrap` орындаңыз.
cli-entware-ssh-repin-required = { $router } роутерінің Entware хост кілті байланғаннан өзгеше: оны тәуелсіз арна арқылы тексеріп, `kcc entware ssh repin` орындаңыз.
cli-entware-ssh-key-unchanged = { $router } роутерінің Entware хост кілті байланғанмен бірдей: қайта байлайтын ештеңе жоқ.
cli-entware-ssh-busy = { $router } роутері басқа өзгеріспен немесе тапсырмамен бос емес: ол аяқталғанда қайталаңыз.
