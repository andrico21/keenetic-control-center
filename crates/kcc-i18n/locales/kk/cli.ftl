cli-entware-no-storage = { $router } роутері Entware іске қоса алмайды: USB және жинақтағыш компоненттері қажет.
cli-entware-unsaved = { $router } роутерінде сақталмаған өзгерістер бар: Entware орнату алдында оларды сақтаңыз немесе болдырмаңыз.
