cli-entware-ssh-forgotten = kcc { $router } роутері үшін SSH кілтін және байламын ұмытты. Оның кілт жолы роутердің authorized_keys файлында сол жерде жойылғанша қалады.
cli-entware-ssh-probe-key = { $router } роутерінің Entware хост кілті: { $value }
cli-entware-ssh-probe-ticket = Билет (бір реттік, бес минут жарамды): { $item }
cli-entware-ssh-probe-check = Растамас бұрын бұл саусақ ізін роутердің өзі көрсететін ізбен сенімді арна арқылы салыстырыңыз (мысалы, Entware консолінде: dropbearkey -y -f /opt/etc/dropbear/dropbear_ed25519_host_key). Содан кейін орындаңыз: kcc entware ssh bootstrap --ticket <билет> --fingerprint <саусақ-ізі> --confirm-destructive { $router }
cli-entware-ssh-enrolled = { $router } роутері үшін Entware SSH тіркелді: kcc { $value } хост кілтін байлады және енді өз кілтімен кіреді.
cli-entware-ssh-default-password = Назар аударыңыз: { $router } роутерінің Entware root құпиясөзі әлі де стандартты: оны роутерде өзгертіңіз.
cli-entware-ssh-revoked = kcc өз кілтін { $router } роутерінен жойып, SSH күйін ұмытты.
