cli-entware-ssh-ticket-missing = { $router } роутері үшін билет жоқ: әр әрекет өз билетін жұмсайды. `kcc entware ssh probe` қайта орындаңыз.
cli-entware-ssh-ticket-expired = { $router } роутерінің билетінің мерзімі өтті: `kcc entware ssh probe` қайта орындаңыз.
cli-entware-ssh-ticket-fingerprint = Расталған саусақ ізі { $router } роутері үшін алынғанмен сәйкес емес: құпиясөз жіберілмеді, билет жұмсалды. Саусақ ізін тексеріп, probe қайта орындаңыз.
cli-entware-ssh-ticket-invalid = Билет { $router } роутеріне, оның SSH портына немесе осы пайдаланушыға тиесілі емес: құпиясөз жіберілмеді, билет жұмсалды. probe қайта орындаңыз.
cli-entware-ssh-hostkey-mismatch = { $router } роутерінің Entware хост кілті енді { $value }, байланған кілт емес: kcc ештеңе жібермеді. Entware қайта орнатылса, жаңа саусақ ізін тәуелсіз арна арқылы тексеріп, `kcc entware ssh repin` орындаңыз.
cli-entware-ssh-auth-rejected = { $router } роутеріндегі Entware кіруді қабылдамады. Сәтсіз bootstrap кейін тіркеу Pending күйінде қалады: дұрыс құпиясөзбен probe және bootstrap қайта орындаңыз.
cli-entware-ssh-disabled = { $router } роутері үшін Entware-ді SSH арқылы басқару өшірулі: `kcc entware ssh enable` орындаңыз.
cli-entware-package-not-installed = { $name } пакеті { $router } роутерінде орнатылмаған; ештеңе өзгертілмеді.
cli-entware-service-unknown = { $router } роутерінде { $name } Entware қызметі жоқ; ештеңе өзгертілмеді.
cli-entware-service-disabled = { $router } роутеріндегі { $name } Entware қызметі өшірілген (ENABLED мәні yes емес); қазір ол { $value }.
