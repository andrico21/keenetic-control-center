# kcc configuration for the rootless Podman deployment (deploy/podman/README.md).
# Install as ~/.config/kcc/etc/kcc.toml; the directory is mounted read-only at /etc/kcc.
# Secrets are never written here: they arrive as Podman secrets under /run/secrets.

[server]
# Inside the container the listener binds every interface so Podman can forward the
# published port to it; exposure is decided by `PublishPort=127.0.0.1:8443:8443`.
listen_addr = "0.0.0.0"
listen_port = 8443
# TLS is mandatory for a non-loopback Web UI. Certificate and key are Podman secrets
# (`kcc-tls-cert`, `kcc-tls-key`); see the README for `kcc tls self-signed`.
tls_cert_path = "/run/secrets/kcc-tls-cert"
tls_key_path = "/run/secrets/kcc-tls-key"
# Optional explicit browser origin, retained here as a deployment assertion; kcc also
# derives this origin from [web] public_url.
allowed_origins = ["https://localhost:8443"]

[web]
enabled = true
# The address browsers use. Its host is also the SNI `kcc healthcheck` sends, so it
# must be a name the certificate carries.
public_url = "https://localhost:8443"

[mcp]
http_enabled = true

[state]
# The `kcc-state` volume; the image also sets KCC_STATE_DIR to this path.
dir = "/var/lib/kcc"

[metrics]
# Optional Prometheus exporter. Podman forwards a published port to the container's
# interface, not to its loopback, so the listener binds 0.0.0.0 inside the container
# and must say so explicitly. Keep it host-loopback-only through the publish address:
# `PublishPort=127.0.0.1:9090:9090`.
enabled = false
bind = "0.0.0.0:9090"
allow_non_loopback = true

# [logs]
# enabled = true
# [[logs.sinks]]
# kind = "loki"
# url = "https://loki.example.net"
# password_file = "/run/secrets/kcc-loki-password"

[[routers]]
name = "home"
url = "http://192.168.1.1"
login = "admin"
# A Podman secret per router password: `podman secret create kcc-router-home <file>`
# plus `Secret=kcc-router-home,target=/run/secrets/kcc-router-home,uid=65532,gid=65532,mode=0400`.
password_file = "/run/secrets/kcc-router-home"
